# Docker build context 에서 제외할 파일 목록.
# 빌드 속도와 이미지 크기 최적화 + 민감 파일 유출 방지.

# 로컬 개발 산출물
node_modules
.next
out
dist

# 로컬 개발용 환경변수 (Railway 는 자체 환경변수 사용)
.env
.env.local
.env.*.local

# Git · CI
.git
.gitignore
.github

# 로그
*.log
npm-debug.log*
pnpm-debug.log*

# 에디터 · OS
.vscode
.idea
.DS_Store
Thumbs.db

# 프로젝트 문서·임시 파일 (런타임 불필요)
docs
tmp
.bkit
지시서
commit-log.txt

# Supabase migrations 는 Railway 배포에 필요 없음
